<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import org.fxmisc.richtext.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dev.ritterackr.bitterlog.controller.MainController"
            prefWidth="1200" prefHeight="800">

    <!-- 上部ツールバー -->
    <top>
        <VBox>
            <!-- メニューバー -->
            <MenuBar>
                <Menu text="ファイル">
                    <MenuItem fx:id="newMemoMenu" text="新規メモ"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="exportMenu" text="エクスポート"/>
                    <MenuItem fx:id="importMenu" text="インポート"/>
                </Menu>
                <Menu text="表示">
                    <CheckMenuItem fx:id="darkModeMenu" text="ダークモード"/>
                    <CheckMenuItem fx:id="filterFavoriteMenu" text="お気に入りのみ表示"/>
                </Menu>
                <Menu text="メモ">
                    <CheckMenuItem fx:id="pinMenu" text="ピン留め"/>
                    <CheckMenuItem fx:id="favoriteMenu" text="お気に入り"/>
                </Menu>
                <Menu text="カテゴリ">
                    <MenuItem fx:id="addCategoryMenu" text="カテゴリ追加"/>
                </Menu>
            </MenuBar>

            <!-- ツールバー -->
            <ToolBar>
                <Button fx:id="newMemoBtn" text="新規メモ"/>
                <Separator/>
                <TextField fx:id="searchField" promptText="検索..." prefWidth="200"/>
                <Button fx:id="searchBtn" text="検索"/>
                <Separator/>
                <Button fx:id="insertImageBtn" text="画像挿入"/>
            </ToolBar>
        </VBox>
    </top>

    <!-- メインコンテンツ -->
    <center>
        <SplitPane fx:id="splitPane">
            <!-- 左側: メモ一覧 -->
            <VBox prefWidth="180">
                <HBox spacing="4" style="-fx-padding: 4;">
                    <ComboBox fx:id="categoryComboBox" promptText="カテゴリ" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="addCategoryBtn" text="+"/>
                </HBox>
                <ListView fx:id="memoListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- 中央: Markdownエディタ -->
            <VBox prefWidth="510">
                <TextField fx:id="titleField" promptText="タイトル"/>
                <HBox spacing="4" style="-fx-padding: 4 0 4 0;">
                    <Label text="カテゴリ"/>
                    <ComboBox fx:id="memoCategoryComboBox" promptText="カテゴリを選択" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <CodeArea fx:id="editorArea" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- 右側: プレビュー -->
            <VBox prefWidth="510">
                <WebView fx:id="previewView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </center>

</BorderPane>