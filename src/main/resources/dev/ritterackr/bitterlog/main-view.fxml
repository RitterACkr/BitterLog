<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import org.fxmisc.richtext.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dev.ritterackr.bitterlog.controller.MainController"
            prefWidth="1200" prefHeight="800">

    <!-- 上部ツールバー -->
    <top>
        <VBox>
            <!-- メニューバー -->
            <MenuBar>
                <Menu text="ファイル">
                    <MenuItem fx:id="newMemoMenu" text="新規メモ"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="exportMenu" text="エクスポート"/>
                    <MenuItem fx:id="importMenu" text="インポート"/>
                </Menu>
                <Menu text="表示">
                    <CheckMenuItem fx:id="darkModeMenu" text="ダークモード"/>
                    <CheckMenuItem fx:id="filterFavoriteMenu" text="お気に入りのみ表示"/>
                </Menu>
                <Menu text="メモ">
                    <CheckMenuItem fx:id="pinMenu" text="ピン留め"/>
                    <CheckMenuItem fx:id="favoriteMenu" text="お気に入り"/>
                </Menu>
                <Menu text="カテゴリ">
                    <MenuItem fx:id="addCategoryMenu" text="カテゴリ追加"/>
                </Menu>
            </MenuBar>

            <!-- ツールバー -->
            <ToolBar>
                <Button fx:id="newMemoBtn" text="新規メモ"/>
                <Separator/>
                <TextField fx:id="searchField" promptText="検索..." prefWidth="200"/>
                <Button fx:id="searchBtn" text="検索"/>
                <Separator/>
                <ToggleButton fx:id="editModeBtn" text="編集"/>
                <Button fx:id="insertImageBtn" text="画像挿入" managed="false" visible="false"/>
            </ToolBar>
        </VBox>
    </top>

    <!-- メインコンテンツ -->
    <center>
        <SplitPane fx:id="splitPane">
            <!-- 左側: メモ一覧 -->
            <VBox prefWidth="200">
                <Label text="カテゴリ" styleClass="sidebar-section-label" style="-fx-padding: 6 8 2 8; -fx-font-weight: bold;"/>
                <HBox spacing="4" style="-fx-padding: 4 4 4 4;" alignment="CENTER">
                    <ComboBox fx:id="categoryComboBox" promptText="すべて" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="addCategoryBtn" text="+" minWidth="35"/>
                    <Button fx:id="editCategoryBtn" text="✏" minWidth="40" disable="true"/>
                    <Button fx:id="deleteCategoryBtn" text="🗑" minWidth="35" disable="true"/>
                </HBox>

                <Separator/>

                <HBox styleClass="sidebar-section-label" alignment="CENTER_LEFT">
                    <Label styleClass="sidebar-section-label" text="タグ" style="-fx-font-weight: bold; -fx-padding: 0;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="clearTagFilterBtn" text="✕" minWidth="24" style="-fx-font-size: 10px; -fx-padding: 6px 10px"/>
                </HBox>
                <ListView fx:id="tagListView" prefHeight="120"/>

                <Separator/>

                <Label text="メモ" styleClass="sidebar-section-label" style="-fx-padding: 6 8 2 8; -fx-font-weight: bold;"/>
                <ListView fx:id="memoListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- 中央: Markdownエディタ -->
            <VBox fx:id="editorPane" prefWidth="510">
                <TextField fx:id="titleField" promptText="タイトル"/>
                <HBox spacing="4" style="-fx-padding: 4 4 4 4;">
                    <Label text="カテゴリ" style="-fx-padding: 0 4 0 0;"/>
                    <ComboBox fx:id="memoCategoryComboBox" promptText="カテゴリを選択" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox spacing="4" style="-fx-padding: 0 0 4 0;">
                    <Label text="タグ:"/>
                    <TextField fx:id="tagField" promptText="タグをカンマ区切りで入力 (ex: aaa, tips)" HBox.hgrow="ALWAYS"/>
                </HBox>
                <CodeArea fx:id="editorArea" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Yu Gothic UI'; -fx-font-size: 13px;"/>
            </VBox>

            <!-- 右側: プレビュー -->
            <VBox prefWidth="510">
                <WebView fx:id="previewView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </center>

</BorderPane>